<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView с TextureView вместо SurfaceView: на некоторых ТВ-приставках видео-слой SurfaceView
  рисуется поверх всего интерфейса, и наши панели (журнал, кнопки) оказываются «под видео».
  С TextureView интерфейс Compose всегда поверх видео.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
